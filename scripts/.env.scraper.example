# Copy this file to scripts/.env.scraper.local and fill in real values.
# Both files match the .env*.local pattern, so .local is gitignored.
#
# For LOCAL Supabase, run `supabase status -o env` and copy the values:
#   API_URL  → SUPABASE_URL
#   SERVICE_ROLE_KEY → SUPABASE_SERVICE_ROLE_KEY
#
# For CLOUD Supabase, get the service_role key from
# https://supabase.com/dashboard/project/ocwmcnjnwvsoxkxkbvmd/settings/api
# (NEVER commit the cloud service_role key.)

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace_me
